# Normalize line endings to LF in the repo; Git converts on checkout for Windows
* text=auto eol=lf

# PHP and web files — always LF
*.php text eol=lf
*.css text eol=lf
*.js  text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.xml text eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.ttf binary
*.woff binary
*.woff2 binary
