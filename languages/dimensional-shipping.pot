#: dimensional-shipping-plugin.php:48
#: dimensional-shipping-plugin.php:265
msgid "Dimensional Shipping requires WooCommerce to be installed and active."
msgstr ""

#: dimensional-shipping-plugin.php:80
#: dimensional-shipping-plugin.php:121
msgid "Dimensional Shipping"
msgstr ""

#: dimensional-shipping-plugin.php:81
msgid "Calculates shipping cost from each product's volume: (Length × Width × Height) ÷ DIM factor × multiplier. The DIM factor and cost multiplier are configurable per shipping zone. A minimum cost and an additional fee can also be set."
msgstr ""

#: dimensional-shipping-plugin.php:120
msgid "Title"
msgstr ""

#: dimensional-shipping-plugin.php:122
msgid "The shipping method name shown to customers at checkout."
msgstr ""

#: dimensional-shipping-plugin.php:127
msgid "Tax Status"
msgstr ""

#: dimensional-shipping-plugin.php:129
msgid "Choose whether the calculated shipping cost is subject to tax."
msgstr ""

#: dimensional-shipping-plugin.php:133
msgid "Taxable"
msgstr ""

#: dimensional-shipping-plugin.php:134
msgid "None"
msgstr ""

#: dimensional-shipping-plugin.php:138
msgid "Store Dimension Settings"
msgstr ""

#. translators: %1$s: dimension unit abbreviation (e.g. cm), %2$s: URL to WooCommerce General settings
#: dimensional-shipping-plugin.php:142
msgid "Your store's dimension unit is set to <strong>%1$s</strong>. Product dimensions will be converted to the unit you choose below before the DIM calculation is applied. You can change your store unit under <a href=\"%2$s\">WooCommerce &rarr; Settings &rarr; General</a>."
msgstr ""

#: dimensional-shipping-plugin.php:148
msgid "DIM Calculation Unit"
msgstr ""

#: dimensional-shipping-plugin.php:150
msgid "The unit your shipping carrier uses for the DIM factor. Product dimensions are converted to this unit before dividing by the DIM factor. Choose the unit that matches the DIM factor value provided by your carrier."
msgstr ""

#: dimensional-shipping-plugin.php:154
msgid "Millimeters (mm)"
msgstr ""

#: dimensional-shipping-plugin.php:155
msgid "Centimeters (cm)"
msgstr ""

#: dimensional-shipping-plugin.php:156
msgid "Meters (m)"
msgstr ""

#: dimensional-shipping-plugin.php:157
msgid "Inches (in)"
msgstr ""

#: dimensional-shipping-plugin.php:158
msgid "Yards (yd)"
msgstr ""

#: dimensional-shipping-plugin.php:163
msgid "DIM Factor"
msgstr ""

#: dimensional-shipping-plugin.php:165
msgid "The divisor in the formula: (L &times; W &times; H) / DIM factor. This value depends on the unit selected above — common carrier values are <strong>5000</strong> for cm and <strong>139</strong> for inches. A higher number produces a lower shipping cost."
msgstr ""

#: dimensional-shipping-plugin.php:173
msgid "Cost Multiplier"
msgstr ""

#: dimensional-shipping-plugin.php:175
msgid "The dimensional weight (volume / DIM factor) is multiplied by this number to produce the final shipping cost. For example, a value of 2.5 means each unit of dimensional weight costs 2.50 in your store currency."
msgstr ""

#: dimensional-shipping-plugin.php:184
msgid "Minimum Cost"
msgstr ""

#: dimensional-shipping-plugin.php:186
msgid "A cost floor applied after the calculation. If the calculated cost is lower than this value, this amount is charged instead. Set to 0 to disable."
msgstr ""

#: dimensional-shipping-plugin.php
msgid "Additional Fee"
msgstr ""

#: dimensional-shipping-plugin.php
msgid "A fixed amount added to every order after the minimum cost is applied, e.g. for packaging or handling. Set to 0 to disable."
msgstr ""

#: dimensional-shipping-plugin.php
msgid "How the shipping cost is calculated"
msgstr ""

#. translators: %s: DIM calculation unit, e.g. cm
#, php-format
#: dimensional-shipping-plugin.php
msgid "Each product's length, width and height are converted to the DIM calculation unit (<strong>%s</strong>)."
msgstr ""

#. translators: %s: DIM factor
#, php-format
#: dimensional-shipping-plugin.php
msgid "Its dimensional weight is (Length &times; Width &times; Height) &divide; DIM factor (<strong>%s</strong>), times the quantity in the cart."
msgstr ""

#. translators: %s: cost multiplier
#, php-format
#: dimensional-shipping-plugin.php
msgid "The dimensional weights of all products are added up and multiplied by the cost multiplier (<strong>%s</strong>)."
msgstr ""

#. translators: %s: minimum cost, formatted as a price
#, php-format
#: dimensional-shipping-plugin.php
msgid "If the result is below the minimum cost (<strong>%s</strong>), the minimum cost is charged instead."
msgstr ""

#. translators: %s: additional fee, formatted as a price
#, php-format
#: dimensional-shipping-plugin.php
msgid "The additional fee (<strong>%s</strong>) is added."
msgstr ""

#: dimensional-shipping-plugin.php
msgid "Tax is added on top, because the tax status is Taxable."
msgstr ""

#: dimensional-shipping-plugin.php
msgid "No tax is added, because the tax status is None."
msgstr ""

#: dimensional-shipping-plugin.php
msgid "Products that are virtual or have no length, width or height count as 0. A cart with only such products is charged the minimum cost plus the additional fee."
msgstr ""

#: dimensional-shipping-plugin.php
msgid "Example with the saved settings: one 40 × 30 × 20 cm box"
msgstr ""

#. translators: 1: length, 2: width, 3: height, 4: unit, 5: volume
#, php-format
#: dimensional-shipping-plugin.php
msgid "%1$s &times; %2$s &times; %3$s %4$s = %5$s"
msgstr ""

#. translators: 1: volume, 2: DIM factor, 3: dimensional weight
#, php-format
#: dimensional-shipping-plugin.php
msgid "%1$s &divide; %2$s = %3$s (dimensional weight)"
msgstr ""

#. translators: 1: dimensional weight, 2: cost multiplier, 3: calculated cost
#, php-format
#: dimensional-shipping-plugin.php
msgid "%1$s &times; %2$s = %3$s"
msgstr ""

#. translators: %s: minimum cost, formatted as a price
#, php-format
#: dimensional-shipping-plugin.php
msgid "Below the minimum cost, so %s is used"
msgstr ""

#. translators: 1: cost after the minimum, 2: additional fee, 3: shipping cost
#, php-format
#: dimensional-shipping-plugin.php
msgid "%1$s + %2$s additional fee = <strong>%3$s</strong> shipping"
msgstr ""

#. translators: %s: shipping cost
#, php-format
#: dimensional-shipping-plugin.php
msgid "Shipping: <strong>%s</strong>"
msgstr ""

#: dimensional-shipping-plugin.php
msgid "The example uses the saved values: save your changes to update it."
msgstr ""
